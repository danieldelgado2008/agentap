<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvPuntos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puntos: 0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#6200EE"
        android:layout_marginBottom="16dp"/>

    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgPet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Dinosaurio Mascota"
            android:src="@drawable/ic_dinosaurio" />

        <ImageView
            android:id="@+id/imgHat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Sombrero Volcán"
            android:src="@drawable/ic_sombrero_volcan"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgGlasses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Lentes"
            android:src="@drawable/ic_lentes"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgBowtie"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Moño"
            android:src="@drawable/ic_monyo"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgCrown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Corona"
            android:src="@drawable/ic_corona"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgArmor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Mazo Cavernícola"
            android:src="@drawable/ic_mazo_cavernicola"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgPaint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Pintura"
            android:src="@drawable/ic_pintura_guerra"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgMustache"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Bigote"
            android:src="@drawable/ic_bigote"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tienda del Dinosaurio"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.gridlayout.widget.GridLayout
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="3"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_sombrero_volcan"/>
                <Button
                    android:id="@+id/btnBuyHat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 pts"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_lentes"/>
                <Button
                    android:id="@+id/btnBuyGlasses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 pts"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_monyo"/>
                <Button
                    android:id="@+id/btnBuyBowtie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 pts"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_pintura_guerra"/>
                <Button
                    android:id="@+id/btnBuyPaint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="40 pts"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_bigote"/>
                <Button
                    android:id="@+id/btnBuyMustache"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 pts"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_mazo_cavernicola"/>
                <Button
                    android:id="@+id/btnBuyArmor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150 pts"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="4dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_corona"/>
                <Button
                    android:id="@+id/btnBuyCrown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300 pts"
                    android:textSize="10sp"/>
            </LinearLayout>

        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>

</LinearLayout>
