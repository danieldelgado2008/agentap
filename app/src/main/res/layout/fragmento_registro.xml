<?xml version="1.0" encoding="utf-8"?>
<!--
    Diseño de la pantalla para crear un perfil nuevo (Registro).
    Pide los datos básicos para que el usuario pueda empezar a usar la app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <!-- Logo pequeño arriba para decorar -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_logo_app" />

    <!-- Título de la pantalla -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear Cuenta"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"/>

    <!-- Espacio vacío para separar el título de los campos -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp" />

    <!-- Campo para que el usuario escriba su nombre completo -->
    <EditText
        android:id="@+id/etRegisterNombre"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nombre"
        android:inputType="textPersonName"
        android:paddingLeft="16dp"
        android:background="@android:drawable/edit_text"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Campo para el correo electrónico (Necesario para la nube) -->
    <EditText
        android:id="@+id/etRegisterEmail"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Correo electrónico"
        android:inputType="textEmailAddress"
        android:paddingLeft="16dp"
        android:background="@android:drawable/edit_text"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Campo para el número de celular o teléfono -->
    <EditText
        android:id="@+id/etRegisterTelefono"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Teléfono"
        android:inputType="phone"
        android:paddingLeft="16dp"
        android:background="@android:drawable/edit_text"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Campo para elegir una clave de acceso -->
    <EditText
        android:id="@+id/etRegisterContrasena"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:paddingLeft="16dp"
        android:background="@android:drawable/edit_text"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp" />

    <!-- Botón para confirmar el registro y crear la cuenta -->
    <Button
        android:id="@+id/btnRegistrar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#6200EE"
        android:text="Registrarse"
        android:textColor="#FFFFFF" />

</LinearLayout>
