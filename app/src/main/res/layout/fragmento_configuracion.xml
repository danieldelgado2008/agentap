<?xml version="1.0" encoding="utf-8"?>
<!--
    Esta pantalla es la "Configuración".
    Permite al usuario personalizar el aspecto de la app y cerrar su sesión.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutConfiguracion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Título de la sección de Ajustes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configuración"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="32dp"/>

    <!-- Etiqueta para la opción de personalización de color -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cambiar color de fondo:"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <!-- Cuadraditos de colores que funcionan como botones para cambiar el fondo -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="48dp">

        <!-- Opción: Blanco -->
        <View
            android:id="@+id/colorWhite"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Opción: Azul Claro -->
        <View
            android:id="@+id/colorLightBlue"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:background="#E3F2FD"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Opción: Rosado Claro -->
        <View
            android:id="@+id/colorLightPink"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:background="#FCE4EC"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Opción: Verde Claro -->
        <View
            android:id="@+id/colorLightGreen"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:background="#E8F5E9"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Botón rojo para salir de la cuenta actual -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Cerrar sesión"
        android:backgroundTint="#FF5252"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp"/>

    <!-- Logo de la app con un toque de transparencia al final -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_logo_app"
        android:alpha="0.5"/>

</LinearLayout>
